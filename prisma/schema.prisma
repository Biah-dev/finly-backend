// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preferences     UserPreferences?
  bankConnections BankConnection[]
}

model UserPreferences {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currency             Currency @default(BRL)
  monthlyIncome        Decimal? @db.Decimal(12, 2)
  budgetAlertThreshold Int      @default(80)
  billingCycleStart    Int      @default(1)
  lowBalanceAlert      Decimal? @db.Decimal(12, 2)
  weeklySummaryEmail   Boolean  @default(true)
  lowBalanceAlerts     Boolean  @default(true)
  billReminders        Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

enum Currency {
  BRL
  USD
  EUR
}

model BankConnection {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pluggyItemId      String  @unique
  connectorName     String
  connectorImageUrl String?
  status            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
